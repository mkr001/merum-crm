# ============================================================
# MERUM CRM — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (get from supabase.com > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT
JWT_SECRET=your-very-long-random-secret-key-here-minimum-32-chars

# Email (for notifications — use Gmail or SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Merum CRM <crm@merums.com>

# File Storage (Supabase Storage bucket name)
STORAGE_BUCKET=merum-crm-documents

# WhatsApp (optional — Twilio or 2Factor)
WHATSAPP_API_KEY=your-whatsapp-api-key
